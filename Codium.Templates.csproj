<Project Sdk="Microsoft.NET.Sdk">

    <!-- Packs templates/** as a `dotnet new` template package. This project builds no code. -->
    <PropertyGroup>
        <PackageType>Template</PackageType>
        <PackageId>Codium.Templates</PackageId>
        <Version>1.0.0</Version>
        <Title>Codium .NET Templates</Title>
        <Authors>Samet Karademir</Authors>
        <Description>dotnet new template for an N-layer ASP.NET Core Web API (Domain, Application, EF Core/PostgreSQL, Identity, JWT, Hangfire, Serilog) with unit, integration and parity tests.</Description>
        <PackageTags>dotnet-new;templates;webapi;aspnetcore;ddd</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/sametkarademir/codium-dotnet-api</RepositoryUrl>
        <RepositoryType>git</RepositoryType>

        <TargetFramework>net9.0</TargetFramework>
        <IncludeContentInPack>true</IncludeContentInPack>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <ContentTargetFolders>content</ContentTargetFolders>
        <EnableDefaultItems>false</EnableDefaultItems>
        <!-- Dot-files (.gitignore, .editorconfig, .template.config) are part of the template. -->
        <NoDefaultExcludes>true</NoDefaultExcludes>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <!-- A template package has no assemblies. -->
        <NoWarn>$(NoWarn);CS2008;NU5128;NU5110;NU5111</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="templates\**\*"
                 Exclude="templates\**\bin\**;templates\**\obj\**;templates\**\.vs\**;templates\**\.idea\**;templates\**\*.user;templates\**\.DS_Store" />
        <Compile Remove="**\*" />
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
